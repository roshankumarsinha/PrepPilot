# Copy to .env and adjust if needed. Values below match docker-compose.yml.
POSTGRES_USER=preppilot
POSTGRES_PASSWORD=preppilot
POSTGRES_DB=preppilot
POSTGRES_PORT=5432

# API
DATABASE_URL=postgres://preppilot:preppilot@localhost:5432/preppilot
PORT=3000

# Embeddings (Ollama runs on the host; see README)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Notes repos: config file and where they are cloned (relative to the repo root)
REPOS_CONFIG=repos.yaml
DATA_DIR=data/repos

# Automatic sync (cron syntax); set SYNC_SCHEDULE_ENABLED=false to turn it off
SYNC_SCHEDULE_ENABLED=true
SYNC_CRON=*/15 * * * *
