{
  "name": "@preppilot/api",
  "version": "0.0.0",
  "private": true,
  "description": "PrepPilot REST API, sync worker and MCP server",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sync": "nest build && node dist/sync.main.js"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.17",
    "@nestjs/testing": "^12.6.3",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@types/supertest": "^7",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/schedule": "^12.0.4",
    "@preppilot/shared": "workspace:^",
    "cron": "4.4.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
